{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd app && npm install --legacy-peer-deps --include=dev && npm run build",
  "outputDirectory": "app/.next",
  "installCommand": "echo 'skip root install'",
  "framework": "nextjs",
  "git": {
    "deploymentEnabled": {
      "main": true
    }
  }
}
