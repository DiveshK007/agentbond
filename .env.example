# ──────────────────────────────────────────────
# AgentBond — Environment Configuration
# ──────────────────────────────────────────────

# ─── Solana ───
RPC_URL=https://api.devnet.solana.com
KEYPAIR_PATH=~/.config/solana/apex-bot-devnet.json

# ─── API Server ───
PORT=3001
API_URL=http://localhost:3001

# ─── Swig Smart Wallets ───
SWIG_REGISTRY=~/.config/agentbond/swig-registry.json

# ─── x402 Payments (Coinbase) ───
# Your Solana wallet address that receives USDC payments
X402_RECEIVER_ADDRESS=YOUR_SOLANA_USDC_ADDRESS

# ─── Zerion Portfolio API ───
# Get a key at https://zerion.io/developers
ZERION_API_KEY=

# ─── LI.FI Cross-Chain ───
# Get a key at https://li.fi/ (optional — works without for testing)
LIFI_API_KEY=

# ─── Frontend (Next.js) ───
NEXT_PUBLIC_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_API_URL=http://localhost:3001
