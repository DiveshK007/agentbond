# ──────────────────────────────────────────────────────────────
# AgentBond — Environment Configuration
# ──────────────────────────────────────────────────────────────

# ─── Solana ─────────────────────────────────────────────────
# RPC endpoint for the API server and bots
RPC_URL=https://api.devnet.solana.com

# ─── API Server ─────────────────────────────────────────────
PORT=3001

# ─── x402 Payment Layer (Coinbase) ──────────────────────────
# Solana wallet address that receives USDC payments for agent services
# MUST be a valid Solana address for x402 facilitator to settle
X402_RECEIVER_ADDRESS=YOUR_SOLANA_USDC_ADDRESS

# ─── Zerion (Portfolio Data) ────────────────────────────────
# Get your key at https://zerion.io/developers
ZERION_API_KEY=

# ─── LI.FI (Cross-Chain Swaps) ──────────────────────────────
# Get your key at https://li.fi/
LIFI_API_KEY=

# ─── Helius (Transaction Monitoring) ────────────────────────
# Get your key at https://helius.dev/
# Used for: webhook monitoring, enhanced transaction history
HELIUS_API_KEY=

# ─── Switchboard (Oracle Price Feeds) ───────────────────────
# SOL/USD feed address (default is mainnet canonical feed)
SWITCHBOARD_SOL_USD_FEED=GvDMxPzN1sCj7L26YDK2HnMRXEQmQ2aemov8YBtPS7vR

# ─── Swig (Smart Wallets) ──────────────────────────────────
# Path to persist Swig wallet registry across restarts
SWIG_REGISTRY=~/.config/agentbond/swig-registry.json

# ─── Metadata Store ────────────────────────────────────────
# Directory for persisting job descriptions and results
METADATA_STORE_DIR=~/.config/agentbond/metadata

# ─── Privy (Embedded Wallets — frontend) ───────────────────
# Sign up at https://dashboard.privy.io/, create an app, copy the App ID
# When set, /register page shows a "Sign in with Email · Google · Apple" button
# that auto-provisions a Solana embedded wallet for the user.
NEXT_PUBLIC_PRIVY_APP_ID=

# ─── MoonPay (Fiat Onramp — frontend) ──────────────────────
# Sign up at https://dashboard.moonpay.com/ for a publishable API key
# When set, /register shows a "Buy SOL with credit card" widget.
# Set NEXT_PUBLIC_MOONPAY_SANDBOX=true for testing without real money.
NEXT_PUBLIC_MOONPAY_API_KEY=
NEXT_PUBLIC_MOONPAY_SANDBOX=true

# ─── Dodo Payments (INR checkout — frontend) ───────────────
# Create a product at https://app.dodopayments.com/products and paste
# the hosted-checkout URL here. Powers premium-tier features:
# Featured job listings (/post) and verified-agent badges (/register).
NEXT_PUBLIC_DODO_PAYMENT_LINK=
